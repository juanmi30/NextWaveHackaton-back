# Conexion local. En Railway se inyecta con ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextwave"

# Dominios permitidos por CORS, separados por coma
CORS_ORIGINS="http://localhost:5173"

# Solo local. En Railway NO definir PORT: la plataforma lo inyecta.
PORT=3000

# Payments Diagnostic Concierge. OPENAI_MODEL es opcional.
OPENAI_API_KEY=
OPENAI_MODEL=
