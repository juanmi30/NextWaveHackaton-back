# Conexion local. En Railway se inyecta con ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextwave"

# Dominios permitidos por CORS, separados por coma
CORS_ORIGINS="http://localhost:5173"

# Solo local. En Railway NO definir PORT: la plataforma lo inyecta.
PORT=3000

# Payments Diagnostic Concierge. OPENAI_MODEL es opcional.
OPENAI_API_KEY=
OPENAI_MODEL=

# Alertas. Si faltan credenciales o destinatarios, el canal se omite.
ALERT_DELIVERY_TIMEOUT_MS=8000

EMAIL_ALERTS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

WHATSAPP_ALERTS_ENABLED=true
WHATSAPP_TO=
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
