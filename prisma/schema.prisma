generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum PaymentStatus {
  APPROVED
  DECLINED
  ERROR
  TIMEOUT
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DetectionOutcome {
  NO_ANOMALY
  INSUFFICIENT_EVIDENCE
  INCIDENTS_FOUND
}

// ---------------------------------------------------------------
// Ingesta
// ---------------------------------------------------------------

model Transaction {
  id         String  @id @default(cuid())
  externalId String? @unique

  // Las seis dimensiones. Texto plano, sin FK a catalogos:
  // el sistema debe aceptar valores que nunca ha visto.
  merchant      String
  provider      String
  method        String
  country       String
  issuingBank   String
  failureReason String?

  status      PaymentStatus
  declineCode String?
  errorType   String?
  latencyMs   Int?

  amountCents    Int
  currency       String  @default("USD")
  amountUsdCents Int     @default(0)
  fxRateId       String?
  fxRate         FxRate? @relation(fields: [fxRateId], references: [id])

  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([provider, country, occurredAt])
  @@index([merchant, issuingBank, occurredAt])
  @@index([method, country, occurredAt])
  @@index([failureReason, occurredAt])
}

model FxRate {
  id          String   @id @default(cuid())
  currency    String
  rateDate    DateTime @db.Date
  usdPerUnit  Decimal  @db.Decimal(18, 8)
  source      String?

  transactions Transaction[]

  @@unique([currency, rateDate])
}

// ---------------------------------------------------------------
// Comportamiento esperado
// ---------------------------------------------------------------

model Baseline {
  id           String @id @default(cuid())
  dimensionKey String
  segmentKey   String
  segment      Json

  hourOfDay Int
  dayOfWeek Int

  expectedRate Float
  variance     Float
  sampleSize   Int
  calculatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([dimensionKey, segmentKey, hourOfDay, dayOfWeek])
  @@index([dimensionKey, segmentKey])
}

// ---------------------------------------------------------------
// Deteccion
// ---------------------------------------------------------------

model DetectionRun {
  id String @id @default(cuid())

  windowStart   DateTime @db.Timestamptz(3)
  windowEnd     DateTime @db.Timestamptz(3)
  baselineStart DateTime @db.Timestamptz(3)
  baselineEnd   DateTime @db.Timestamptz(3)

  params          Json
  combosEvaluated Int              @default(0)
  outcome         DetectionOutcome
  durationMs      Int?
  finishedAt      DateTime         @default(now()) @db.Timestamptz(3)

  incidents   Incident[]
  diagnoses   IncidentDiagnosis[]

  @@index([finishedAt])
  @@index([outcome, finishedAt])
}

// ---------------------------------------------------------------
// Incidentes
// ---------------------------------------------------------------

model Incident {
  id             String       @id @default(cuid())
  detectionRunId String
  detectionRun   DetectionRun @relation(fields: [detectionRunId], references: [id])

  anchorFingerprint String
  fingerprint       String

  status   IncidentStatus @default(OPEN)
  severity Int            @default(0)

  expectedApprovals  Int @default(0)
  actualApprovals    Int @default(0)
  lostApprovals      Int @default(0)
  averageTicketCents Int @default(0)
  lossPerMinuteCents Int @default(0)

  summaryOps          String?
  summaryExec         String?
  recommendation      String?
  confidenceStatement String?

  startedAt  DateTime  @db.Timestamptz(3)
  detectedAt DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)

  diagnoses  IncidentDiagnosis[]
  escalation IncidentEscalation?

  @@index([status, detectedAt])
  @@index([anchorFingerprint])
  @@index([fingerprint])
  @@index([detectedAt])
}

model IncidentDiagnosis {
  id             String       @id @default(cuid())
  incidentId     String
  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  detectionRunId String
  detectionRun   DetectionRun @relation(fields: [detectionRunId], references: [id])

  version         Int
  fingerprint     String
  dimensions      Json
  dimensionDepth  Int

  baselineRate     Float
  observedRate     Float
  baselineAttempts Int
  observedAttempts Int
  confidence       Float

  sampleTransactionIds Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  evidence DiagnosisEvidence[]

  @@unique([incidentId, version])
  @@index([fingerprint])
}

model DiagnosisEvidence {
  id          String            @id @default(cuid())
  diagnosisId String
  diagnosis   IncidentDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  dimension      String
  dimensionValue String

  baselineRate Float
  observedRate Float
  difference   Float
  attempts     Int
  confidence   Float
  isRootCause  Boolean @default(false)

  @@index([diagnosisId])
  @@index([diagnosisId, isRootCause])
}

// ---------------------------------------------------------------
// Escalamiento de alertas
// ---------------------------------------------------------------

enum RecipientRole {
  CHECKOUT_ENGINEER
  INTEGRATIONS_ENGINEER
  PROVIDER_MANAGER
  RISK_ANALYST
  MERCHANT_SUCCESS
  PAYMENTS_OPS
  ADMIN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum EscalationStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  EXHAUSTED
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Recipient {
  id    String        @id @default(cuid())
  name  String
  email String?
  phone String?
  role  RecipientRole

  // Alcance de responsabilidad. Un arreglo vacio significa "cubre todo".
  merchants String[] @default([])
  providers String[] @default([])
  countries String[] @default([])

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  notifications  AlertNotification[]
  acknowledgedEscalations IncidentEscalation[] @relation("AcknowledgedBy")

  @@index([role, active])
}

model EscalationPolicy {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  minSeverity Int     @default(0)
  maxSeverity Int     @default(5)

  steps       EscalationStep[]
  escalations IncidentEscalation[]
}

model EscalationStep {
  id       String           @id @default(cuid())
  policyId String
  policy   EscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  level       Int
  waitMinutes Int    @default(0)
  label       String

  roles              RecipientRole[]       @default([])
  includeSpecialists Boolean               @default(true)
  channels           NotificationChannel[] @default([])

  @@unique([policyId, level])
}

model IncidentEscalation {
  id         String   @id @default(cuid())
  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  policyId String
  policy   EscalationPolicy @relation(fields: [policyId], references: [id])

  status       EscalationStatus @default(PENDING)
  currentLevel Int              @default(0)

  // Por que se enruto asi. Se persiste para poder defender la decision.
  category      String?
  actionability String?
  routedRoles   RecipientRole[] @default([])
  routingReason String?

  nextEscalationAt DateTime?  @db.Timestamptz(3)
  acknowledgedAt   DateTime?  @db.Timestamptz(3)
  acknowledgedById String?
  acknowledgedBy   Recipient? @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  closedAt         DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)

  notifications AlertNotification[]

  @@index([status, nextEscalationAt])
}

model AlertNotification {
  id           String             @id @default(cuid())
  escalationId String
  escalation   IncidentEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id])

  level   Int
  role    RecipientRole?
  channel NotificationChannel
  status  NotificationStatus
  target  String?
  error   String?
  sentAt  DateTime            @default(now()) @db.Timestamptz(3)

  @@index([escalationId, level])
}
