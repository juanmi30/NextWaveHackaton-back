generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  APPROVED
  DECLINED
  ERROR
  TIMEOUT
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Transaction {
  id           String        @id @default(cuid())
  merchant     String
  provider     String
  method       String
  country      String
  issuingBank  String
  status       PaymentStatus
  declineCode  String?
  errorType    String?
  latencyMs    Int?
  amountCents  Int
  currency     String        @default("USD")
  occurredAt   DateTime      @default(now())

  @@index([occurredAt])
  @@index([provider, country, occurredAt])
  @@index([merchant, issuingBank, occurredAt])
  @@index([method, country, occurredAt])
}

model Incident {
  id             String         @id @default(cuid())
  title          String
  dimensions     Json
  severity       Int            @default(0)
  status         IncidentStatus @default(OPEN)
  baselineRate   Float
  observedRate   Float
  estimatedLoss  Int            @default(0)
  evidence       Json?
  recommendation String?
  detectedAt     DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([status, detectedAt])
  @@index([detectedAt])
}
